# Copy this file to .env and fill in your values

# LLM API Key (OpenAI or Gemini-compatible)
# Leave blank to use mock responses (demo mode)
LLM_API_KEY=

# Model to use — examples:
#   OpenAI:  gpt-4o-mini
#   Gemini:  gemini-1.5-flash  (via openai-compat endpoint)
LLM_MODEL=gpt-4o-mini

# Optional: custom base URL for Gemini or other OpenAI-compat providers
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# SQLite database file path
DATABASE_URL=sqlite:///./patternpilot.db
